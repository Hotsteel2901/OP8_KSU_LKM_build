 /* ---- pre-5.10 portability shims (legacy branch; see LEGACY_PORTING.md) ----
  *
@@ -53,6 +55,28 @@
 # endif
 #endif /* < 5.10 */
 
+/* regs_set_return_value() is per-arch and only appeared in 5.5; arm64 4.19 has no such
+ * helper (arch/arm64/include/asm/syscall.h defines only syscall_get/set_return_value).
+ * Used by sus_map / sus_path / susfs_hide_syms, all of which include this header. */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 5, 0) && defined(CONFIG_ARM64)
+static inline void regs_set_return_value(struct pt_regs *regs, unsigned long val)
+{
+	regs->regs[0] = val;
+}
+#endif
+
+/* task_work_add() took a bool ("notify") before the TWA_* enum; the enum value TWA_RESUME
+ * (1) equals the old notify=true. Used by susfs_supercall.c. */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 7, 0) && !defined(TWA_RESUME)
+#define TWA_RESUME true
+#endif
+
+/* regs_get_kernel_argument() is 5.5+; on arm64 the syscall arguments are simply the
+ * first registers. Used by sus_path.c and susfs_hide_syms.c. */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 5, 0) && !defined(regs_get_kernel_argument)
+#define regs_get_kernel_argument(regs, n)	((regs)->regs[n])
+#endif
